# Optional: enables synthesized RAG answers. Without this key SmartStock uses a
# deterministic, source-grounded fallback so the demo still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Token signing secret — MUST be changed in production deployments.
SMARTSTOCK_TOKEN_SECRET=change-this-in-production
ENVIRONMENT=development
# Set false in production to require authentication for every workspace endpoint.
ALLOW_DEMO=true

# Token expiry in seconds (default 24 hours).
SMARTSTOCK_TOKEN_EXPIRY=86400
